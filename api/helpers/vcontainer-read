#!/usr/bin/python3
import json
import re
import sys
from pathlib import Path

GROUPS = Path("/sys/fs/cgroup/vcontainer")
STATES = Path("/var/lib/vcontainer/containers")


def read(path):
    try:
        return path.read_text().strip()
    except FileNotFoundError:
        return None


def inspect(name):
    if name in (".", "..") or not re.fullmatch(r"[A-Za-z0-9_.-]+", name):
        raise ValueError("Invalid name")

    group = GROUPS / name
    if not group.is_dir() and not (STATES / name).is_dir():
        raise ValueError("Container not found")

    pids = (read(group / "cgroup.procs") or "").split()
    data = {
        "name": name,
        "status": "running" if pids else "stopped",
        "host_pids": [int(pid) for pid in pids],
    }

    for key, file in {
        "memory_current": "memory.current",
        "memory_max": "memory.max",
        "pids_current": "pids.current",
        "pids_max": "pids.max",
        "cpu_max": "cpu.max",
    }.items():
        data[key] = read(group / file)
    return data


def main():
    args = sys.argv[1:]

    if args == ["images"]:
        folder = Path("/tmp/vcontainer-images")
        if not folder.is_dir():
            return []
        return [
            {"name": path.name, "rootfs": str(path / "rootfs")}
            for path in sorted(folder.iterdir())
            if (path / "rootfs").is_dir()
        ]

    if args == ["ps"]:
        names = set()
        for folder in (GROUPS, STATES):
            if folder.is_dir():
                names.update(p.name for p in folder.iterdir() if p.is_dir())
        return [inspect(name) for name in sorted(names)]

    if len(args) != 2 or args[0] not in ("inspect", "logs"):
        raise ValueError("Use: images, ps, inspect NAME, or logs NAME")

    action, name = args
    data = inspect(name)
    if action == "logs":
        output = read(STATES / name / "container.log")
        if output is None:
            raise ValueError("No logs found")
        return output
    return data


if __name__ == "__main__":
    try:
        print(json.dumps(main()))
    except (ValueError, OSError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
